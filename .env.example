# ========================= REQUIRED =========================

# Gemini API Key — required for LLM reasoning and semantic embeddings
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ========================= GEMINI CONFIG =========================

# Gemini model for legal reasoning (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Semantic RAG embedding model
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768

# ========================= AUTH & SECURITY =========================

# JWT signing secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=ip-sakti-dev-secret-change-in-production

# Demo mode — set to 'true' to skip authentication for demo/development
# When true, all requests use a default demo user
DEMO_MODE=true

# Default demo user email (only used in demo mode)
DEMO_EMAIL=demo@ipsakti.local

# ========================= DATA PERSISTENCE =========================

# Local data directory for JSON persistence (default: ./data)
DATA_DIR=./data

# PostgreSQL connection (optional — for production deployment)
# When set, the system uses PostgreSQL instead of JSON files
# DATABASE_URL=postgresql://user:password@localhost:5432/ipsakti

# ========================= FILE UPLOAD =========================

# Maximum upload file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ========================= RATE LIMITING =========================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# ========================= APPLICATION =========================

# Application URL (auto-injected by hosting platforms)
APP_URL=http://localhost:3000

# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development
